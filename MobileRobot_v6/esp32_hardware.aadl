package esp32_hardware
public

with Processor_Properties;
with robot_data;
with SEI;
-- adicionado pelo GPT Astra
with platform_os;
with robot_power;
-- Adicionado pelo GPT Astra.

processor cpu
	features
    	i2c_access: requires bus access I2C;
		serial_access: requires bus access UART;

	properties    
		Scheduling_Protocol=>(POSIX_1003_HIGHEST_PRIORITY_FIRST_PROTOCOL);
		Processor_Properties::Processor_Frequency => 240 MHz;
end cpu;

bus I2C
	properties

		SEI::BandWidthCapacity => 100000.0 bitsps;

		SEI::BandWidthBudget => 20000.0 bitsps;
		
		Communication_Properties::Transmission_Time =>
    	[Fixed => 450 us .. 450 us;
     	PerByte => 90 us .. 90 us;];
end I2C;


bus UART
	properties
		SEI::BandWidthCapacity => 115200.0 bitsps;
		SEI::BandWidthBudget => 80000.0 bitsps;
		Communication_Properties::Transmission_Time =>
		[Fixed => 0 us .. 0 us;
		 PerByte => 87 us .. 87 us;];
end UART;


device battery_sensor
	features
		state: out data port robot_data::battery_raw.impl;
end battery_sensor;

memory ram
	properties
		Memory_Size => 520 KByte;
end ram;

memory flash
	properties
		Memory_Size => 4 MByte;
end flash;

device wheel_encoders
	features
		state: out data port robot_data::encoder_state.impl;
end wheel_encoders;

device motor_actuation
	features
-- adicionado pelo GPT Astra
		Supply: requires bus access robot_power::motor_6v
			{ SEI::PowerBudget => 30.0 W; }; -- Combined driver/motor allocation; verify stall current.
-- Adicionado pelo GPT Astra.
		command: in data port robot_data::motor_drive.impl;
end motor_actuation;

device IMU
	features
		state: out data port robot_data::imu_raw.impl;
		i2c_access: requires bus access I2C;
	flows
        measurement_source: flow source state;
end IMU;

-- adicionado pelo GPT Astra
device board_power_load
	features
		Supply: requires bus access robot_power::logic_5v
			{ SEI::PowerBudget => 2.5 W; }; -- Assumed board + sensor allowance, not measured.
end board_power_load;
-- Adicionado pelo GPT Astra.
system esp_platform
	features
-- adicionado pelo GPT Astra
		Supply: requires bus access robot_power::logic_5v;
-- Adicionado pelo GPT Astra.
		i2c_access: requires bus access I2C;
		serial_access: requires bus access UART;

end esp_platform;

system implementation esp_platform.impl
 	subcomponents
-- adicionado pelo GPT Astra
		zephyr_core_0: virtual processor platform_os::zephyr_scheduler;
		zephyr_core_1: virtual processor platform_os::zephyr_scheduler;
		board_power: device board_power_load;
-- Adicionado pelo GPT Astra.
 		esp_memory : memory ram;
		core_0 : processor cpu;
		core_1: processor cpu;
		esp_flash : memory flash;
	connections
-- adicionado pelo GPT Astra
		board_supply: bus access Supply <-> board_power.Supply;
-- Adicionado pelo GPT Astra.
		serial_to_core_0:
			bus access serial_access <-> core_0.serial_access;
		i2c_to_core_0:
        	bus access i2c_access <-> core_0.i2c_access;
    	i2c_to_core_1:
        	bus access i2c_access <-> core_1.i2c_access;

		
-- adicionado pelo GPT Astra
	properties
		Actual_Processor_Binding => (reference (core_0)) applies to zephyr_core_0;
		Actual_Processor_Binding => (reference (core_1)) applies to zephyr_core_1;
-- Adicionado pelo GPT Astra.
end esp_platform.impl;

end esp32_hardware;
