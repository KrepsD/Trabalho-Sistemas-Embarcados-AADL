// Deadlines compare annotated analytical response bounds, not measured timing.
// Recompute response bounds after workload, scheduler or binding changes.

system requirements MobileRobotV6_ESP32_Timing for esp32_software::firmware.impl [
	see goals MobileRobotV6_ESP32_Goals
	requirement Deadline_control_task: "control_task response deadline" for control_task [
		see goal MobileRobotV6_ESP32_Goals.Operation
		val deadlineLimit = 10 ms
		val worstResponse = max(#SEI::Response_Time)
		description "Each job shall finish within deadlineLimit after dispatch, including interference and blocking. Verify under the declared workload, bindings and scheduling policy."
		value predicate worstResponse > 0 us
			and worstResponse >= max(#Timing_Properties::Compute_Execution_Time)
			and worstResponse <= deadlineLimit and #Timing_Properties::Deadline == deadlineLimit
	]

	requirement Deadline_imu_task: "imu_task response deadline" for imu_task [
		see goal MobileRobotV6_ESP32_Goals.Operation
		val deadlineLimit = 20 ms
		val worstResponse = max(#SEI::Response_Time)
		description "Each job shall finish within deadlineLimit after dispatch, including interference and blocking. Verify under the declared workload, bindings and scheduling policy."
		value predicate worstResponse > 0 us
			and worstResponse >= max(#Timing_Properties::Compute_Execution_Time)
			and worstResponse <= deadlineLimit and #Timing_Properties::Deadline == deadlineLimit
	]

	requirement Deadline_battery_task: "battery_task response deadline" for battery_task [
		see goal MobileRobotV6_ESP32_Goals.Operation
		val deadlineLimit = 500 ms
		val worstResponse = max(#SEI::Response_Time)
		description "Each job shall finish within deadlineLimit after dispatch, including interference and blocking. Verify under the declared workload, bindings and scheduling policy."
		value predicate worstResponse > 0 us
			and worstResponse >= max(#Timing_Properties::Compute_Execution_Time)
			and worstResponse <= deadlineLimit and #Timing_Properties::Deadline == deadlineLimit
	]

	requirement Deadline_telemetry_task: "telemetry_task response deadline" for telemetry_task [
		see goal MobileRobotV6_ESP32_Goals.Operation
		val deadlineLimit = 20 ms
		val worstResponse = max(#SEI::Response_Time)
		description "Each job shall finish within deadlineLimit after dispatch, including interference and blocking. Verify under the declared workload, bindings and scheduling policy."
		value predicate worstResponse > 0 us
			and worstResponse >= max(#Timing_Properties::Compute_Execution_Time)
			and worstResponse <= deadlineLimit and #Timing_Properties::Deadline == deadlineLimit
	]

	requirement Deadline_rx_task: "rx_task response deadline" for rx_task [
		see goal MobileRobotV6_ESP32_Goals.Operation
		val deadlineLimit = 20 ms
		val worstResponse = max(#SEI::Response_Time)
		description "Each job shall finish within deadlineLimit after dispatch, including interference and blocking. Verify under the declared workload, bindings and scheduling policy."
		value predicate worstResponse > 0 us
			and worstResponse >= max(#Timing_Properties::Compute_Execution_Time)
			and worstResponse <= deadlineLimit and #Timing_Properties::Deadline == deadlineLimit
	]

	requirement Deadline_command_guard_task: "command_guard_task response deadline" for command_guard_task [
		see goal MobileRobotV6_ESP32_Goals.Operation
		val deadlineLimit = 10 ms
		val worstResponse = max(#SEI::Response_Time)
		description "Each job shall finish within deadlineLimit after dispatch, including interference and blocking. Verify under the declared workload, bindings and scheduling policy."
		value predicate worstResponse > 0 us
			and worstResponse >= max(#Timing_Properties::Compute_Execution_Time)
			and worstResponse <= deadlineLimit and #Timing_Properties::Deadline == deadlineLimit
	]

	// Interfaces require model review and integration tests.
	requirement Interface_encoder_input: "encoder_input interface contract" for encoder_input [
		see goal MobileRobotV6_ESP32_Goals.Operation
		description "Accept signed wheel encoder count deltas for motor feedback."
		informal predicate "Inspect interface type, direction and connections; verify behavior in the integration test."
	]
	requirement Interface_battery_input: "battery_input interface contract" for battery_input [
		see goal MobileRobotV6_ESP32_Goals.Operation
		description "Accept raw ADC battery samples for voltage conversion."
		informal predicate "Inspect interface type, direction and connections; verify behavior in the integration test."
	]
	requirement Interface_motor_output: "motor_output interface contract" for motor_output [
		see goal MobileRobotV6_ESP32_Goals.Operation
		description "Provide signed normalized commands for both wheel drives."
		informal predicate "Inspect interface type, direction and connections; verify behavior in the integration test."
	]
	requirement Interface_aquisition: "aquisition interface contract" for aquisition [
		see goal MobileRobotV6_ESP32_Goals.Operation
		description "Accept raw accelerometer and gyroscope samples for conversion and filtering."
		informal predicate "Inspect interface type, direction and connections; verify behavior in the integration test."
	]
	requirement Interface_conversion: "conversion interface contract" for conversion [
		see goal MobileRobotV6_ESP32_Goals.Operation
		description "Provide filtered acceleration in m/s^2 and angular velocity in rad/s."
		informal predicate "Inspect interface type, direction and connections; verify behavior in the integration test."
	]
	requirement Interface_command_input: "command_input interface contract" for command_input [
		see goal MobileRobotV6_ESP32_Goals.Operation
		description "Accept command frames using a one-element queue that drops the oldest frame on overflow."
		informal predicate "Inspect interface type, direction and connections; verify behavior in the integration test."
	]
	requirement Interface_telemetry_output: "telemetry_output interface contract" for telemetry_output [
		see goal MobileRobotV6_ESP32_Goals.Operation
		description "Provide telemetry frames containing encoder, IMU and battery information."
		informal predicate "Inspect interface type, direction and connections; verify behavior in the integration test."
	]

]

