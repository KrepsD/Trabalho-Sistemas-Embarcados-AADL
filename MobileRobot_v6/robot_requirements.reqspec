system requirements MobileRobotV6_RAM for raspberry_hardware::raspberry_platform.impl [
	see goals MobileRobotV6_RAM_Goals
	// Scenario units: metres, pixels, frames/s.
	val roomWidthMetres = 10
	val roomLengthMetres = 10
	val operationDuration = 30 min
	val depthWidthPixels = 640
	val depthHeightPixels = 480
	val depthFramesPerSecond = 15
	val sensorQueueDepth = 1
	// D435i depth + CameraInfo enabled; RGB, published IR, camera IMU and point cloud disabled.
	// Depth-to-LaserScan supplies both SLAM and Nav2; ESP32 supplies odometry sensors.
	// Scenario assumptions, not runtime configuration.

	requirement RAM_Reserve: "At least 20 percent usable RAM reserve" for rpi_ram [
		see goal MobileRobotV6_RAM_Goals.Operation
		val minimumReserve = 0.20
		compute usableRam: real units AADL_Project::Size_Units
		compute peakAccountedRam: real units AADL_Project::Size_Units
		description "Peak accounted demand shall not exceed 80 percent of usable physical RAM. Include the OS, ROS2/DDS, D435i driver and perception conversion, Nav2, SLAM Toolbox, Jason, bridges and bounded buffers, counting shared memory once. Swap is not additional RAM."
		rationale "Provisional 20 percent margin for the declared D435i scenario: a 10 by 10 metre room and 30 minutes of mapping and navigation. Map resolution and SLAM history limits must be documented before verification."
		value predicate usableRam > 0 Bytes and peakAccountedRam >= 0 Bytes and peakAccountedRam <= usableRam * (1.0 - minimumReserve)
	]

	requirement RAM_Runtime: "Available RAM during the deployment test" for rpi_ram [
		see goal MobileRobotV6_RAM_Goals.Operation
		val minimumAvailableFraction = 0.20
		compute observedMinimumFraction: real
		description "With the complete architecture active, including chonOS, ROS2, D435i perception conversion, odometry, SLAM Toolbox, Nav2, Jason and both bridges, maintain Linux MemAvailable/MemTotal at or above 0.20 throughout 30 continuous minutes of mapping and navigation in a 10 by 10 metre room. Also monitor startup. Record sampling interval, camera profile, map settings and all driver/DDS queues; sensor queues target the latest sample. Sampling does not prove absence of all transient peaks."
		value predicate observedMinimumFraction >= minimumAvailableFraction and observedMinimumFraction <= 1.0
	]
	// Interfaces require model review and integration tests.
	requirement Interface_serial_access: "serial_access interface contract" for serial_access [
		see goal MobileRobotV6_RAM_Goals.Operation
		description "Provide UART bus access for the command and telemetry link to the ESP32."
		informal predicate "Inspect interface type, direction and connections; verify behavior in the integration test."
	]

	// Platform interfaces require analysis and hardware verification.
	requirement Interface_Supply: "Supply interface contract" for Supply [
		see goal MobileRobotV6_RAM_Goals.Operation
		description "Supply regulated 5 V to the Raspberry board, including its downstream USB power allocation."
		informal predicate "Inspect bus access connections and declared capacities against the selected hardware."
	]
	requirement Interface_USB_supply: "USB_supply interface contract" for USB_supply [
		see goal MobileRobotV6_RAM_Goals.Operation
		description "Supply the camera through the shared Raspberry USB 5 V power envelope."
		informal predicate "Inspect bus access connections and declared capacities against the selected hardware."
	]
	requirement Interface_usb_access: "usb_access interface contract" for usb_access [
		see goal MobileRobotV6_RAM_Goals.Operation
		description "Connect the D435i to the Raspberry USB host using the declared depth profile and payload budget."
		informal predicate "Inspect bus access connections and declared capacities against the selected hardware."
	]

]
