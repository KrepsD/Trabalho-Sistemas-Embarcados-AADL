package robot_data
public

with Base_Types;

data encoder_state
end encoder_state;

data desired_wheel_speed
end desired_wheel_speed;

data motor_drive
end motor_drive;

-- raw imu data
data imu_raw
end imu_raw;

-- converted sample (measurement units, m/s^2 and rad/s)
data imu_sample
end imu_sample;

-- Variacao assinada das contagens desde a leitura anterior.
-- Um campo por roda; valores positivos representam avanco.
-- Intervalo nominal entre leituras: 10 ms.
data implementation encoder_state.impl
	subcomponents
		R_wheel_encoder: data Base_Types::Integer_16;
		L_wheel_encoder: data Base_Types::Integer_16;
	properties
		Data_Size => 4 Bytes;
end encoder_state.impl;

-- Angular velocity: rad/s
-- Positive numbers: foward
-- Negative numbers: backwards
data implementation desired_wheel_speed.impl
	subcomponents
		R_wheel_speed: data Base_Types::Float_32;
		L_wheel_speed: data Base_Types::Float_32;
	properties
		Data_Size => 8 Bytes;
end desired_wheel_speed.impl;


-- Normalized commands between -1.0 and +1.0
-- Signal indicates rotation direction
-- Absolute value indicates duty cycle: 0.6 = 60%
-- For values 0: depends on driver (h-bridge).
data implementation motor_drive.impl
	subcomponents
		R_wheel_command: data Base_Types::Float_32;
		L_wheel_command: data Base_Types::Float_32;
	properties
		Data_Size => 8 Bytes;
end motor_drive.impl;

data implementation imu_raw.impl
		subcomponents
		accel_x: data Base_Types::Integer_16;
		accel_y: data Base_Types::Integer_16;
		accel_z: data Base_Types::Integer_16;
		gyro_x: data Base_Types::Integer_16;
		gyro_y: data Base_Types::Integer_16;
		gyro_z: data Base_Types::Integer_16;
	properties
		Data_Size => 12 Bytes;
end imu_raw.impl;

data implementation imu_sample.impl
		subcomponents
		accel_x: data Base_Types::Float_32;
		accel_y: data Base_Types::Float_32;
		accel_z: data Base_Types::Float_32;
		gyro_x: data Base_Types::Float_32;
		gyro_y: data Base_Types::Float_32;
		gyro_z: data Base_Types::Float_32;
	properties
		Data_Size => 24 Bytes;
end imu_sample.impl;

data encoder_totals
end encoder_totals;

data battery_raw
end battery_raw;

data battery_state
end battery_state;

data command_frame
end command_frame;

data validated_command
end validated_command;

data telemetry_frame
end telemetry_frame;

data implementation encoder_totals.impl
	subcomponents
		R_wheel_total: data Base_Types::Integer_32;
		L_wheel_total: data Base_Types::Integer_32;
	properties
		Data_Size => 8 Bytes;
end encoder_totals.impl;


data implementation battery_raw.impl
	subcomponents
		adc_count: data Base_Types::Unsigned_16;
	properties
		Data_Size => 2 Bytes;
end battery_raw.impl;


data implementation battery_state.impl
	subcomponents
		voltage: data Base_Types::Float_32;
		adc_count: data Base_Types::Unsigned_16;
		status: data Base_Types::Unsigned_16;
	properties
		Data_Size => 8 Bytes;
end battery_state.impl;

data implementation command_frame.impl
	subcomponents
		sync: data Base_Types::Unsigned_16;
		length: data Base_Types::Unsigned_16;
		sequence: data Base_Types::Unsigned_32;
		speed: data desired_wheel_speed.impl;
		validity_ms: data Base_Types::Unsigned_16;
		crc: data Base_Types::Unsigned_16;
	properties
		Data_Size => 20 Bytes;
end command_frame.impl;


data implementation validated_command.impl
	subcomponents
		speed: data desired_wheel_speed.impl;
		sequence: data Base_Types::Unsigned_32;
		received_at_ms: data Base_Types::Unsigned_32;
		validity_ms: data Base_Types::Unsigned_16;
		valid: data Base_Types::Unsigned_16;
	properties
		Data_Size => 20 Bytes;
end validated_command.impl;

data implementation telemetry_frame.impl
	subcomponents
		sync: data Base_Types::Unsigned_16;
		length: data Base_Types::Unsigned_16;
		sequence: data Base_Types::Unsigned_32;
		assembled_at_ms: data Base_Types::Unsigned_32;
		encoders: data encoder_totals.impl;
		imu: data imu_sample.impl;
		battery: data battery_state.impl;
		crc: data Base_Types::Unsigned_16;
	properties
		Data_Size => 54 Bytes;
end telemetry_frame.impl;

-- adicionado pelo GPT Astra
-- D435i depth frame: 640 * 480 pixels * 2 bytes (Z16).
data perception_raw
	properties
		Data_Size => 614400 Bytes;
end perception_raw;
-- Adicionado pelo GPT Astra.

data pose2d
end pose2d;

data odometry_state
end odometry_state;

data velocity_command
end velocity_command;

data nav_goal
end nav_goal;

data nav_status
end nav_status;

data agent_directive
end agent_directive;

data agent_feedback
end agent_feedback;

-- Pose 2D no referencial do mapa/odom.
data implementation pose2d.impl
	subcomponents
		x: data Base_Types::Float_32;
		y: data Base_Types::Float_32;
		theta: data Base_Types::Float_32;
	properties
		Data_Size => 12 Bytes;
end pose2d.impl;

-- Estado fundido (odometria/estado): pose estimada + velocidades correntes.
data implementation odometry_state.impl
	subcomponents
		pose: data pose2d.impl;
		linear_velocity: data Base_Types::Float_32;
		angular_velocity: data Base_Types::Float_32;
	properties
		Data_Size => 20 Bytes;
end odometry_state.impl;

-- Saida do Nav2 no referencial do robo (equivalente ao cmd_vel do ROS 2).
data implementation velocity_command.impl
	subcomponents
		linear_x: data Base_Types::Float_32;
		angular_z: data Base_Types::Float_32;
	properties
		Data_Size => 8 Bytes;
end velocity_command.impl;

-- Meta de navegacao enviada pela integracao Jason-ROS 2 ao Nav2.
data implementation nav_goal.impl
	subcomponents
		target: data pose2d.impl;
		goal_id: data Base_Types::Unsigned_32;
	properties
		Data_Size => 16 Bytes;
end nav_goal.impl;

-- Status do Nav2 sobre a meta corrente (idle/running/succeeded/aborted).
data implementation nav_status.impl
	subcomponents
		goal_id: data Base_Types::Unsigned_32;
		state: data Base_Types::Unsigned_16;
	properties
		Data_Size => 6 Bytes;
end nav_status.impl;

-- Diretiva de alto nivel do agente Jason para a integracao Jason-ROS 2.
data implementation agent_directive.impl
	subcomponents
		goal: data nav_goal.impl;
		task_id: data Base_Types::Unsigned_32;
	properties
		Data_Size => 20 Bytes;
end agent_directive.impl;

-- Retorno da integracao Jason-ROS 2 para o agente (resultado da tarefa).
data implementation agent_feedback.impl
	subcomponents
		task_id: data Base_Types::Unsigned_32;
		status: data nav_status.impl;
	properties
		Data_Size => 10 Bytes;
end agent_feedback.impl;


end robot_data;
