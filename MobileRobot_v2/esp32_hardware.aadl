package esp32_hardware
public

--Obtained from Provant implementation processor_properties.aadl
with Processor_Properties;
with robot_data;
with SEI;

processor cpu
	features
    	i2c_access: requires bus access I2C;
	properties    
		Scheduling_Protocol=>(POSIX_1003_HIGHEST_PRIORITY_FIRST_PROTOCOL);
		Processor_Properties::Processor_Frequency => 240 MHz;
end cpu;

-- Considering an MPU-6050 IMU at 100 kHz
-- message has 12 bytes (accelerometer and gyroscope), so (450 + 12*90)
-- fixed includes 3 bytes from protocol and 2 bytes from temperature reading, that is not being used
-- It doesnt model wait time and adicional time due to START/STOP of I2C 
bus I2C
	properties
		-- Nominal capacity for 100 kHz SCL (channel that sends data)
		SEI::BandWidthCapacity => 100000.0 bitsps;
		-- Chosen arbitrarily: 20% of nominal capacity
		SEI::BandWidthBudget => 20000.0 bitsps;
		
		Communication_Properties::Transmission_Time =>
    	[Fixed => 450 us .. 450 us;
     	PerByte => 90 us .. 90 us;];
end I2C;

memory ram
	properties
		Memory_Size => 520 KByte;
end ram;

memory flash
	properties
		Memory_Size => 4 MByte;
end flash;

device wheel_encoders
	features
		state: out data port robot_data::encoder_state.impl;
end wheel_encoders;

device motor_actuation
	features
		command: in data port robot_data::motor_drive.impl;
end motor_actuation;

device IMU
	features
		state: out data port robot_data::imu_raw.impl;
		i2c_access: requires bus access I2C;
	flows
        measurement_source: flow source state;
end IMU;

system esp_platform
	features
		i2c_access: requires bus access I2C;
end esp_platform;

system implementation esp_platform.impl
 	subcomponents
 		esp_memory : memory ram;
		core_0 : processor cpu;
		core_1: processor cpu;
		esp_flash : memory flash;
	connections
		i2c_to_core_0:
        	bus access i2c_access <-> core_0.i2c_access;

    	i2c_to_core_1:
        	bus access i2c_access <-> core_1.i2c_access;

		
end esp_platform.impl;

end esp32_hardware;