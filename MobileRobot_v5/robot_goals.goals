stakeholder goals MobileRobotV5_ESP32_Goals for esp32_software::firmware.impl [
	goal Operation: "ESP32 operation" [
		stakeholder MobileRobotV5_Stakeholders.projectOwner
		description "Keep control, sensing and communication within the declared response deadlines."
	]
]

stakeholder goals MobileRobotV5_Raspberry_Goals for raspberry_software::navigation_stack.impl [
	goal Operation: "Raspberry operation" [
		stakeholder MobileRobotV5_Stakeholders.projectOwner
		description "Keep navigation, communication and agent decisions within the declared response deadlines."
	]
]

stakeholder goals MobileRobotV5_RAM_Goals for raspberry_hardware::raspberry_platform.impl [
	goal Operation: "RAM operation" [
		stakeholder MobileRobotV5_Stakeholders.projectOwner
		description "Maintain at least 20 percent usable RAM available during the documented 30 minute operating scenario."
	]
]

stakeholder goals MobileRobotV5_ModelRAM_Goals for robot_system::robot.impl [
	goal Operation: "Static RAM budget feasibility" [
		stakeholder MobileRobotV5_Stakeholders.projectOwner
		description "Keep modeled ESP32 RAM within its data pool and preserve 20 percent of modeled Raspberry RAM capacity."
	]
]
