system requirements MobileRobotV4_RAM for raspberry_hardware::raspberry_platform.impl [
	requirement RAM_Reserve: "At least 20 percent usable RAM reserve" for rpi_ram [
		val minimumReserve = 0.20
		compute usableRam: real units AADL_Project::Size_Units
		compute peakAccountedRam: real units AADL_Project::Size_Units
		description "Peak accounted demand shall not exceed 80 percent of usable physical RAM. Include the OS, ROS2/DDS, D435i driver and perception conversion, Nav2, SLAM Toolbox, Jason, bridges and bounded buffers, counting shared memory once. Swap is not additional RAM."
		rationale "Provisional engineering margin. Fix camera streams, resolution/FPS, queue sizes, map limits and operating duration before evaluating."
		value predicate usableRam > 0 Bytes and peakAccountedRam >= 0 Bytes and peakAccountedRam <= usableRam * (1.0 - minimumReserve)
	]

	requirement RAM_Runtime: "Available RAM during the deployment test" for rpi_ram [
		val minimumAvailableFraction = 0.20
		compute observedMinimumFraction: real
		description "During the declared full-stack test, including startup and map growth, the minimum sampled Linux MemAvailable/MemTotal shall be at least 0.20. Record sampling interval, test duration and configuration. Sampling does not prove absence of all transient peaks."
		value predicate observedMinimumFraction >= minimumAvailableFraction and observedMinimumFraction <= 1.0
	]
]
