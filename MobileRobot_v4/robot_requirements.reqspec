system requirements MobileRobotV4_ESP32_Timing for esp32_software::firmware.impl [
	requirement Deadline_control_task: "control_task response deadline" for control_task [
		val deadlineLimit = 10 ms
		compute worstResponse: real units AADL_Project::Time_Units
		description "Each job shall finish within deadlineLimit after dispatch, including interference and blocking. Verify under the declared workload, bindings and scheduling policy."
		value predicate worstResponse <= deadlineLimit and #Timing_Properties::Deadline == deadlineLimit
	]

